generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  timezone String @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
  applications Application[]
  contacts Contact[]
  documents Document[]
  imports ImportBatch[]
}
model Session {
  id String @id
  expiresAt DateTime
  token String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model Account {
  id String @id
  accountId String
  providerId String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}
model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
}
enum Status {
  Saved
  Applied
  Interviewing
  Offer
  Rejected
  Withdrawn
}
enum Arrangement {
  remote
  hybrid
  onsite
}
enum Format {
  video
  phone
  onsite
}
model Application {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  company String
  jobTitle String
  jobUrl String?
  location String @default("")
  arrangement Arrangement @default(remote)
  salaryMin Int?
  salaryMax Int?
  currency String @default("USD")
  status Status @default(Saved)
  dateApplied DateTime? @db.Date
  notes String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  interviews Interview[]
  reminders Reminder[]
  history StatusHistory[]
  contacts Contact[]
  documents ApplicationDocument[]
  @@index([userId, createdAt])
  @@index([userId, status, arrangement])
  @@index([userId, company])
}
model Interview {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title String
  startsAt DateTime
  duration Int?
  format Format
  meetingUrl String?
  location String @default("")
  notes String @default("")
  @@index([startsAt])
  @@index([applicationId])
}
model Reminder {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  message String
  dueAt DateTime
  completedAt DateTime?
  cancelledAt DateTime?
  revision Int @default(1)
  sentAt DateTime?
  deliveryStartedAt DateTime?
  deliveryPayload Json?
  deliveryStatus String @default("pending")
  lastError String?
  attempts Int @default(0)
  lastAttemptAt DateTime?
  deliveryAttempts DeliveryAttempt[]
  createdAt DateTime @default(now())
  @@index([dueAt, deliveryStatus])
  @@index([applicationId])
}
model StatusHistory {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus Status?
  toStatus Status
  createdAt DateTime @default(now())
  @@index([applicationId, createdAt])
}
model Contact {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  name String
  company String @default("")
  title String @default("")
  email String?
  phone String @default("")
  profileUrl String?
  notes String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, name])
  @@index([applicationId])
}
model Document {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  kind String
  createdAt DateTime @default(now())
  versions DocumentVersion[]
  @@index([userId, createdAt])
}
model DocumentVersion {
  id String @id @default(cuid())
  documentId String
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  number Int
  label String
  filename String
  mimeType String
  size Int
  sha256 String
  content Bytes
  notes String @default("")
  createdAt DateTime @default(now())
  applications ApplicationDocument[]
  @@unique([documentId, number])
}
model ApplicationDocument {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  versionId String
  version DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([applicationId, versionId])
  @@index([versionId])
}
model ImportBatch {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  checksum String
  count Int
  createdAt DateTime @default(now())
  @@unique([userId, checksum])
}
model DeliveryAttempt {
  id String @id @default(cuid())
  reminderId String
  reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  revision Int
  outcome String
  error String?
  createdAt DateTime @default(now())
  @@index([reminderId, createdAt])
}
model WorkerHealth {
  id String @id
  startedAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  lastSuccessAt DateTime?
  lastError String?
  failures Int @default(0)
}
