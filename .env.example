DATABASE_URL=postgresql://folio:folio@localhost:5432/folio
REDIS_URL=redis://localhost:6381
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:4000
WEB_URL=http://localhost:3000
API_PORT=4000
# Next proxy destination; never exposed to browser
API_URL=http://localhost:4000
# smtp for Mailpit; resend for production with provider idempotency
EMAIL_PROVIDER=smtp
EMAIL_FROM=Folio <reminders@folio.local>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Optional for authenticated SMTP
SMTP_USER=
SMTP_PASSWORD=
# Required with EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Optional: external uptime checks call /health/worker with Authorization: Bearer <token>
# Use a separate random secret of at least 32 characters. Set on API; never in the browser.
MONITORING_TOKEN=
